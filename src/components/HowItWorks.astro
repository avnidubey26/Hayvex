---
import SectionHeader from "./SectionHeader.astro";

interface Step {
  title: string;
  description: string;
}

interface Props {
  title?: string;
  description?: string;
  steps?: Step[];
}

const {
  title = "How It Works",
  description =
    "Extract text from your documents in three simple steps. Everything happens securely inside your browser.",
  steps = [
    {
      title: "Upload Image",
      description:
        "Select a JPG, PNG, JPEG or WEBP image from your device.",
    },
    {
      title: "AI OCR Processing",
      description:
        "Hayvex analyzes the image locally in your browser and extracts editable text.",
    },
    {
      title: "Copy or Download",
      description:
        "Copy the extracted text instantly or download it as a TXT file.",
    },
  ],
} = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
  <SectionHeader
    badge="SIMPLE PROCESS"
    title={title}
    description={description}
  />

  <div class="mt-14 grid gap-8 md:grid-cols-3">
    {
      steps.map((step, index) => (
        <div
          class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition duration-300 hover:border-[#D4AF37]/30 hover:bg-white/[0.05]"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#D4AF37]/10 text-lg font-bold text-[#D4AF37]">
            {index + 1}
          </div>

          <h3 class="mt-5 text-xl font-semibold text-white">
            {step.title}
          </h3>

          <p class="mt-3 leading-7 text-zinc-400">
            {step.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
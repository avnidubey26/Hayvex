---
const features = [
  {
    icon: "⚡",
    title: "Browser OCR",
    description:
      "Fast OCR directly inside your browser. No servers. No installation.",
  },
  {
    icon: "🔒",
    title: "Privacy First",
    description: "Every document stays on your device. Nothing is uploaded.",
  },
  {
    icon: "📄",
    title: "PDF OCR",
    description:
      "Extract text from single and multi-page PDF documents instantly.",
  },
  {
    icon: "🖼️",
    title: "Image OCR",
    description:
      "Supports JPG, PNG, JPEG and WEBP with high recognition accuracy.",
  },
  {
    icon: "⬇️",
    title: "Export Results",
    description: "Copy extracted text or download it as a clean TXT file.",
  },
  {
    icon: "💻",
    title: "Cross Platform",
    description:
      "Works in Chrome, Edge, Firefox and Safari without installation.",
  },
];
---

<section id="features" class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <span
      class="inline-flex rounded-full border border-[#D4AF37]/25 bg-[#D4AF37]/10 px-4 py-1.5 text-xs font-medium tracking-wide text-[#F4D56A]"
    >
      WHY HAYVEX
    </span>

    <h2 class="mt-5 text-3xl font-bold tracking-tight text-white md:text-4xl">
      Built for{" "}
      <span
        class="bg-gradient-to-r from-[#FFE89B] via-[#D4AF37] to-[#A97A14] bg-clip-text text-transparent"
      >
        Speed
      </span>
      {" "} & Privacy
    </h2>

    <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-zinc-400">
      Fast, browser-based OCR with complete privacy and zero cloud uploads.
    </p>
  </div>

  <div class="mt-12 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <div class="rounded-2xl border border-white/8 bg-white/[0.025] p-5 transition duration-300 hover:border-[#D4AF37]/30 hover:bg-white/[0.04]">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#D4AF37]/10 text-xl">
            {feature.icon}
          </div>

          <h3 class="mt-4 text-lg font-semibold text-white">{feature.title}</h3>

          <p class="mt-2 text-sm leading-6 text-zinc-400">
            {feature.description}
          </p>
        </div>
      ))
    }
  </div>

  <div class="mt-12 border-t border-white/10 pt-6">
    <div
      class="flex flex-wrap justify-center gap-3 text-xs uppercase tracking-wide text-zinc-500"
    >
      <span>No Signup</span>

      <span>•</span>

      <span>Browser Based</span>

      <span>•</span>

      <span>Private OCR</span>

      <span>•</span>

      <span>Free</span>
    </div>
  </div>
</section>

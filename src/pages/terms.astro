---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms of Service | Hayvex"
  description="Terms of Service for Hayvex."
>

<section class="mx-auto max-w-4xl px-6 py-20">
  <h1 class="text-4xl font-bold text-white">
    Terms of Service
  </h1>

  <div class="mt-8 space-y-6 text-zinc-300 leading-8">

    <p>
      By using Hayvex, you agree to use the service responsibly and lawfully.
    </p>

    <p>
      Hayvex is provided "as is" without warranties of any kind.
    </p>

    <p>
      Users are responsible for the documents they upload and for complying
      with applicable laws.
    </p>

    <p>
      Vaikva may update or discontinue features without prior notice.
    </p>

  </div>
</section>

</BaseLayout>